# =============================================================================
# Portfolio — Dokploy Environment
# Paste ke Dokploy → Compose → Environment
#
# Routing:
#   NPM (LXC lain) → http://DOKPLOY_LXC_HOST:80 (Traefik)
#   Traefik Host(APP_DOMAIN) → portfolio:APP_PORT
# =============================================================================

NODE_ENV=production

# Port internal app (Dokploy Domains → Container Port)
APP_PORT=3000

# Dokploy Domains
APP_DOMAIN=portfolio.example.com
APP_SERVICE=portfolio

# IP/hostname LXC Dokploy — dipakai NPM sebagai forward target :80
DOKPLOY_LXC_HOST=192.168.1.50
DOKPLOY_TRAEFIK_PORT=80

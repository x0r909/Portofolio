# =============================================================================
# Portfolio — Environment (Proxmox multi-LXC)
# Paste ke Dokploy → Compose → Environment
#
# LXC:
#   Cloudflare LXC  →  NPM LXC  →  Dokploy LXC
#
# Routing di LXC Dokploy:
#   NPM  →  http://DOKPLOY_LXC_HOST:80   (Traefik bawaan Dokploy)
#   Traefik (Host: APP_DOMAIN)  →  portfolio:3000
#
# Portfolio compose HANYA listen internal :3000 (tidak publish ke host).
# Yang di-publish ke LXC host adalah Traefik :80 (bawaan Dokploy).
# =============================================================================

# --- Runtime (dipakai docker-compose) ---
NODE_ENV=production

# Port internal app (nginx di container). Dipakai Dokploy Domains → Container Port.
APP_PORT=3000

# --- Dokploy Domains ---
APP_DOMAIN=portfolio.example.com
APP_SERVICE=portfolio

# --- Target NPM (LXC lain → LXC Dokploy) ---
# IP/hostname LXC Dokploy
DOKPLOY_LXC_HOST=192.168.1.50

# Port Traefik bawaan Dokploy di host LXC (NPM forward ke sini)
DOKPLOY_TRAEFIK_PORT=80

# (Opsional) dokumentasi LXC lain
NPM_LXC_HOST=192.168.1.51
CLOUDFLARE_LXC_HOST=192.168.1.52

# =============================================================================
# Setup
# =============================================================================
#
# Dokploy → Domains:
#   Host            = ${APP_DOMAIN}
#   Service         = ${APP_SERVICE}
#   Container Port  = ${APP_PORT}          # 3000
#   HTTPS           = OFF
#   Certificate     = None
#
# NPM → Proxy Host:
#   Domain          = ${APP_DOMAIN}
#   Scheme          = http
#   Forward Host    = ${DOKPLOY_LXC_HOST}  # IP LXC Dokploy
#   Forward Port    = ${DOKPLOY_TRAEFIK_PORT}  # 80 (Traefik)
#   SSL             = off
#
# Cloudflare Tunnel:
#   ${APP_DOMAIN} → http://${NPM_LXC_HOST}:80
#
# Pastikan Traefik Dokploy publish 80 di LXC Dokploy (default).
# Jangan publish portfolio:3000 ke host — biarkan Traefik yang expose :80.
# =============================================================================

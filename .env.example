# =============================================================================
# Portfolio — Environment (homeserver)
# Paste seluruh file ini ke Dokploy → Compose → Environment
#
# Infrastruktur:
#   Cloudflare → Nginx Proxy Manager → Dokploy Traefik → portfolio
#
# Traffic:
#   Internet
#     → Cloudflare (TLS / Tunnel)
#     → NPM  (Proxy Host, HTTP ke upstream)
#     → dokploy-traefik:80
#     → portfolio:${APP_PORT}
# =============================================================================

# --- Runtime (dipakai docker-compose) ---
NODE_ENV=production

# Port internal nginx di container (harus sama dengan Container Port di Dokploy Domains)
APP_PORT=3000

# --- Routing reference (Dokploy Domains + NPM) ---
# Domain publik (isi sesuai domainmu)
APP_DOMAIN=portfolio.example.com

# Nama service di docker-compose.yml (Dokploy Domains → Service)
APP_SERVICE=portfolio

# Upstream Traefik dari sisi NPM (NPM & Traefik harus di network yang sama, biasanya dokploy-network)
# NPM Proxy Host → Forward Hostname/IP + Port:
NPM_UPSTREAM_HOST=dokploy-traefik
NPM_UPSTREAM_PORT=80

# Dokploy Domains:
#   Host            = ${APP_DOMAIN}
#   Service         = ${APP_SERVICE}
#   Container Port  = ${APP_PORT}
#   HTTPS           = OFF
#   Certificate     = None
#
# NPM Proxy Host:
#   Domain Names    = ${APP_DOMAIN}
#   Scheme          = http
#   Forward Host    = ${NPM_UPSTREAM_HOST}
#   Forward Port    = ${NPM_UPSTREAM_PORT}
#   SSL di NPM      = off (TLS di Cloudflare)
#
# Cloudflare:
#   Tunnel / DNS → NPM (bukan langsung ke Dokploy)
#   SSL/TLS mode  = Full atau Full (Strict)

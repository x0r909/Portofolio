# ===========================================
# Portfolio — Dokploy / Docker Compose config
# Copy to .env and fill in values (Dokploy UI
# also writes these into .env automatically)
# ===========================================

# App identity
APP_NAME=portfolio
APP_DOMAIN=portfolio.example.com
APP_PORT=3000

# Runtime
NODE_ENV=production

# Traefik (Dokploy reverse proxy)
TRAEFIK_ENABLE=true
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
